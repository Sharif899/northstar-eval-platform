# Northstar Eval Platform — environment template.
# Copy to .env and fill in values. NEVER commit a real .env file.
# The mock providers need no key at all; only set the key below when
# you point the platform at a real LLM API.

# API key for a real LLM provider (OpenAI-compatible endpoints).
# Read at runtime from the environment only — never hard-code it.
NORTHSTAR_LLM_API_KEY=

# Base URL of the LLM API (OpenAI-compatible chat completions).
# Leave unset to use the built-in mock providers.
NORTHSTAR_LLM_BASE_URL=

# Default model name sent to the provider, e.g. gpt-4o-mini.
NORTHSTAR_LLM_MODEL=

# Google Gemini, via its OpenAI-compatible chat-completions endpoint.
# The endpoint is the FULL request URL, including /chat/completions —
# it is posted to verbatim, no path is appended. The free tier has no
# card; Google may use free-tier prompts to improve its products, so
# send no sensitive data through it. Pace live runs at about one call
# every 6–7 seconds to stay under the free-tier rate limit.
NORTHSTAR_GEMINI_API_KEY=<redacted>
NORTHSTAR_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
NORTHSTAR_GEMINI_MODEL=gemini-3.5-flash-lite

# Default prompt version label recorded in run manifests.
NORTHSTAR_PROMPT_VERSION=v1

# SQLite database file used by the CLI and the web UI.
NORTHSTAR_DB=./northstar.db
